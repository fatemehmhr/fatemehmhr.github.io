# ---------------------------------------------------------------------------
# Contact form SMTP configuration (used by /api/contact + src/lib/mailer.ts)
# ---------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in real values. Never commit secrets.
#
#   cp .env.example .env.local
#
# For Gmail you MUST use an "App Password" (not your account password):
#   1. Enable 2-Step Verification on the Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an app password and paste it into SMTP_PASS.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=96mehri@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO_EMAIL=96mehri@gmail.com
